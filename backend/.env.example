# Copy to .env for local development. Railway injects the production
# equivalents of these as project/service environment variables — never
# commit real values.

ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# Railway's managed Postgres addon provides this automatically in deployed
# environments. For local dev, point at a local/dev Postgres instance.
DATABASE_URL=postgresql://knohow:knohow@localhost:5432/knohow

# GCP OAuth client (Web application type) — see docs/gcp-setup.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Inline JSON of the domain-wide-delegation service account key, OR a
# filesystem path to the key file. Never commit the key itself.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Fernet key: generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
TOKEN_ENCRYPTION_KEY=

# Any long random string; generate with `python -c "import secrets; print(secrets.token_urlsafe(64))"`
JWT_SIGNING_KEY=

FRONTEND_ORIGIN=http://localhost:3000

# Resend — abandoned Book a Demo recovery email (noreply@knohow.app; domain verified).
# https://resend.com/api-keys — never commit the real key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@knohow.app
# Seconds of sheet idle before the one-shot recovery email (default 1200 = 20 min).
DEMO_RECOVERY_IDLE_SECONDS=1200
