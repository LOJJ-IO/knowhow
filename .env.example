# FastAPI backend origin (backend/). Continue with Google redirects the browser here.
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
# Landing and app origins (ADR 0022). Prod: https://knohow.app and
# https://app.knohow.app. Leave both unset locally: one origin then serves
# both, with the app's front door at /entry. A local split can't work: the app
# must be on `localhost` to share the backend's cookies (Google's callback is
# localhost:8000), and Next's dev server rewrites any redirect to `localhost`
# back onto whatever host the visitor used.
# NEXT_PUBLIC_SITE_ORIGIN=https://knohow.app
# NEXT_PUBLIC_APP_ORIGIN=https://app.knohow.app
