# FastAPI backend origin (backend/). Continue with Google redirects the browser here.
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000

# Google Picker API key (browser). Used only by the personal-Drive import picker.
# Public by design (ships in the browser) — restrict it in GCP to Websites +
# the Google Picker API. GCP: knohow-staging. Leave unset until the picker is wired.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
